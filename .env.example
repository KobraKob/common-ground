# CommonGround local development environment.
# Copy to .env and replace every placeholder. Never commit .env.

ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_URL=http://localhost:3000

# PostgreSQL / Supabase local development
DATABASE_URL=postgresql+asyncpg://postgres:replace-me@localhost:54322/postgres
LOCAL_SQLITE_URL=sqlite+aiosqlite:///./commonground.db

# Local Supabase values. Use Supabase-generated values; do not reuse production secrets.
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=replace-with-local-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-supabase-service-role-key
SUPABASE_JWT_SECRET=replace-with-local-supabase-jwt-secret

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-supabase-anon-key
